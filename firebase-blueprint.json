{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and system role in SILABKOM",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Full name of the user" },
        "role": {
          "type": "string",
          "description": "User access level ID (admin, administrator, kepala_lab, guru_mapel, kepala_sekolah, teknisi, wali_kelas, petugas_absensi, or custom role created by Administrator)"
        },
        "position": { "type": "string", "description": "Job title / Jabatan di sekolah atau laboratorium" },
        "nip": { "type": "string", "description": "Employee ID number (NIP/NUPTK)" },
        "subject": { "type": "string", "description": "Teaching subject or unit" },
        "phone": { "type": "string", "description": "Phone or WhatsApp number" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "assignedClassIds": { "type": "array", "items": { "type": "string" }, "description": "Assigned class IDs for Wali Kelas or Petugas Absensi scoping" },
        "hasCustomPermissions": { "type": "boolean", "description": "Whether per-user custom permissions override role defaults" },
        "customAllowedMenus": { "type": "array", "items": { "type": "string" }, "description": "Custom menu allowlist for this user" },
        "customPermissions": { "type": "object", "description": "Custom action permissions map for this user" },
        "isActive": { "type": "boolean", "description": "Whether account is enabled" },
        "authProvisioned": { "type": "boolean", "description": "Whether Firebase Auth account is provisioned" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" },
        "disabledAt": { "type": "string", "format": "date-time" },
        "disabledBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "isActive"]
    },
    "UserInvite": {
      "title": "UserInvite",
      "description": "Pre-linked account invite & role assignment for existing Firebase Auth emails (keyed by normalized email)",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "position": { "type": "string" },
        "nip": { "type": "string" },
        "subject": { "type": "string" },
        "phone": { "type": "string" },
        "assignedClassIds": { "type": "array", "items": { "type": "string" } },
        "hasCustomPermissions": { "type": "boolean" },
        "customAllowedMenus": { "type": "array", "items": { "type": "string" } },
        "customPermissions": { "type": "object" },
        "isActive": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "displayName", "role", "isActive"]
    },
    "AccessRole": {
      "title": "AccessRole",
      "description": "Dynamic access level definition managed by Administrator",
      "type": "object",
